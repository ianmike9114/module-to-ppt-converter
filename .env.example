# Copy to .env.local for dev; set the same names in Vercel Environment Variables for production.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: Canva Connect integration (canva.com/developers -> Your integrations)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Must exactly match a redirect URL registered on the integration
CANVA_REDIRECT_URI=http://127.0.0.1:3000/api/canva/callback
# Random string, 32+ chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CANVA_SESSION_SECRET=
